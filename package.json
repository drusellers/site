{
	"name": "dru",
	"version": "1.0.0",
	"description": "Personal website built with TanStack Start",
	"main": "get-content.js",
	"type": "module",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "vite dev",
		"build": "vite build && tsc --noEmit",
		"build:cf": "NITRO_PRESET=cloudflare_module npm run build",
		"start": "node .output/server/index.mjs",
		"preview": "vite preview",
		"preview:cf": "npm run build:cf && wrangler dev --config wrangler.jsonc",
		"deploy:stg": "npm run build:cf && wrangler deploy --config wrangler.jsonc --env stg",
		"deploy:prd": "npm run build:cf && wrangler deploy --config wrangler.jsonc --env prd",
		"typecheck": "tsc --noEmit",
		"format:check": "npx biome format",
		"fmt": "npx biome format --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drusellers/site.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/drusellers/site/issues"
	},
	"homepage": "https://github.com/drusellers/site#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.0.0",
		"@types/react": "^19",
		"@types/react-dom": "^19.2.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.0.4",
		"nitro": "^3.0.260610-beta",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.1.5",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@fontsource-variable/open-sans": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@fortawesome/fontawesome-pro": "^7.0.1",
		"@fortawesome/fontawesome-svg-core": "^7.0.1",
		"@fortawesome/free-brands-svg-icons": "^7.0.1",
		"@fortawesome/pro-light-svg-icons": "^7.0.1",
		"@fortawesome/pro-solid-svg-icons": "^7.0.1",
		"@fortawesome/react-fontawesome": "^3.0.2",
		"@markdoc/markdoc": "^0.5.0",
		"@mdx-js/mdx": "^3.1.0",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.12",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.32",
		"date-fns": "^4.1.0",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11",
		"react": "^19",
		"react-dom": "^19",
		"react-hotkeys-hook": "^5.0.0",
		"tailwindcss": "^4.0.7",
		"use-debounce": "^10.0.0",
		"yaml": "^2.4.1",
		"zod": "^4.3.5"
	}
}
